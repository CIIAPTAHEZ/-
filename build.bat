@echo off
chcp 65001 >nul
title Сборка приложения «Анализ рекламаций»
echo ============================================================
echo   Сборка приложения «Анализ рекламаций и операционного контроля»
echo ============================================================
echo.

cd /d "%~dp0"

echo [1/3] Установка зависимостей...
python -m pip install -r requirements.txt
if errorlevel 1 (
    echo [ОШИБКА] Не удалось установить зависимости.
    pause
    exit /b 1
)

echo.
echo [2/3] Установка PyInstaller...
python -m pip install pyinstaller
if errorlevel 1 (
    echo [ОШИБКА] Не удалось установить PyInstaller.
    pause
    exit /b 1
)

echo.
echo [3/3] Сборка исполняемого файла...
python -m PyInstaller --noconfirm --clean build.spec
if errorlevel 1 (
    echo [ОШИБКА] Сборка завершилась с ошибкой.
    pause
    exit /b 1
)

echo.
echo ============================================================
echo   Сборка завершена!
echo   Готовое приложение находится в папке: dist\Анализ_рекламаций\
echo.
echo   Для запуска на этом или другом компьютере (Windows):
echo   1. Скопируйте папку dist\Анализ_рекламаций\ целиком.
echo   2. Запустите файл: Анализ_рекламаций.exe
echo   При первом запуске автоматически создадутся папки:
echo     - data     (база данных и резервные копии)
echo     - exports  (временные файлы)
echo     - claims_files (документы по претензиям)
echo ============================================================
echo.
pause